<!-- Microsoft.NET.Sdk.Worker DEGIL: bu makinedeki SDK 10.0.401'de o MSBuild SDK'si
     cozulemedi (MSB4236). Worker SDK'sinin yaptigi tek sey OutputType=Exe +
     Hosting paketi referansidir; ikisi de asagida ACIKCA duruyor. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>tetikte-rag-motor</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tetikte.Rag.Core\Tetikte.Rag.Core.csproj" />
  </ItemGroup>

</Project>
