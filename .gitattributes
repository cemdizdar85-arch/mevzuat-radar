# ============================================================================
#  ROBOT ÇIKTISI — ÇAKIŞMA ÇÖZÜMÜ (30.08.2026)
#
#  NEDEN: O gün iki tel 3 gün ayrı kaldı ve 89 dosya çakıştı. Ölçüldü:
#  89'un 80'i veri/ kökündeki ROBOT RAPORUYDU, yalnız 9'u insan işiydi.
#  Çarpışmanın %90'ı, "her koşuda yeniden üretilen" dosyaların iki yerde
#  birden üretilmesinden geliyordu. Bu dosyaların çakışması ANLAMSIZDIR:
#  içerikleri son robot koşusunun fotoğrafıdır, bir sonraki koşuda tazelenir.
#
#  ⚠ DRIVER ADI "ours" OLAMAZ. Git'in built-in merge driver'ları yalnız
#  üç tanedir: text · binary · union. `merge=ours` yazmak SESSİZCE HİÇBİR ŞEY
#  YAPMAZ - 30.08'de denendi, dosya yine çakıştı, kural çalışıyor sanıldı.
#  Bu yüzden aşağıdaki "tetikte-robot" driver'ı git config'de TANIMLANMAK
#  ZORUNDADIR; tanımını `motor/oturum.ps1 -Ac` her açılışta kurar
#  (merge.tetikte-robot.driver = true → hiçbir şey yapmaz, yereldeki kalır).
#  Tanım yoksa kural yine sessizce çalışmaz - oturum betiği bunu denetler.
#
#  ⛔ BU KURALA ASLA GERÇEK VERİ SOKULMAZ. Desenler yalnız veri/ KÖKÜNDEKİ
#  rapor/damga/nöbet çıktılarına vurur (gitattributes'te "*" eğik çizgiyi
#  geçmez). Elle yutulan mevzuat (veri/mevzuat/**, 841 dosya), çıkmış sınav
#  arşivleri (kgk-arsiv 609 · sgs-arsiv 824 · smmm-arsiv 901) ve soru
#  fabrikası (veri/fabrika/**) DIŞARIDADIR - içlerinde yeniden üretilemeyen
#  iş vardır, normal birleşirler.
#
#  30.08 ölçümü sınırı da gösterdi: 21 dosyada uzak sürüm küçüktü ama
#  hiçbirinde gerçek kayıp yoktu; buna karşılık 3 İNSAN İŞİ dosyasında YEREL
#  doğruydu. Kural bu yüzden yalnız robot çıktısına uygulanır, insan işine asla.
#
#  TEST EDİLDİ (30.08): desen içindeki dosya çakışmadan çözüldü, desen
#  dışındaki dosya normal çakıştı. Kural çalışıyor.
# ============================================================================
veri/*-ozet.json          merge=tetikte-robot
veri/*-raporu.json        merge=tetikte-robot
veri/*-rapor.json         merge=tetikte-robot
veri/*-raporu.txt         merge=tetikte-robot
veri/*-log.txt            merge=tetikte-robot
veri/*-damga.json         merge=tetikte-robot
veri/*-damgasi.json       merge=tetikte-robot
veri/*-nobeti.json        merge=tetikte-robot
veri/*-nobet-log.txt      merge=tetikte-robot
veri/*-durum.json         merge=tetikte-robot
veri/*-karnesi.json       merge=tetikte-robot
veri/*-olcum.json         merge=tetikte-robot
veri/*-kapisi.json        merge=tetikte-robot
veri/SINAV-TEK-SAYFA.md   merge=tetikte-robot
veri/sinav-tek-sayfa.json merge=tetikte-robot
veri/nabiz-*.json         merge=tetikte-robot
veri/gorev-nabzi.json     merge=tetikte-robot
veri/sabah-rapor.json     merge=tetikte-robot
veri/URUN-KUNYELERI.json  merge=tetikte-robot

# İSTİSNA — gerçek veri, normal birleşir (yukarıdaki desenler zaten alt
# klasörlere vurmaz; burası niyeti açıkça yazmak içindir):
veri/mevzuat/**       !merge
veri/fabrika/**       !merge
veri/kgk-arsiv/**     !merge
veri/sgs-arsiv/**     !merge
veri/smmm-arsiv/**    !merge
veri/yutma-arsiv/**   !merge

# 30.08 CAKISMA DERSI: veri/ihale-kesik-firma-adi.json cakisti ve merge=tetikte-robot
# kurali onu KAPSAMIYORDU (desenler yalniz *-ozet / *-raporu / *-damga idi).
# Iki taraf ICERIKCE AYNIYDI (115 kayit, 14.437 taranan); tek fark bicimdi -
# yerel PS 5.1 dort bosluk girinti + \uXXXX kacisi, CI'daki pwsh 7 iki bosluk.
# Yani ayni veri iki farkli JSON bicimiyle yaziliyor ve her seferinde cakisiyor.
# Denetim/olcum ciktilarinin hepsi de robot ciktisidir: cakisma cikmasin.
veri/*-denetimi.json      merge=tetikte-robot
veri/*-olcum.json         merge=tetikte-robot
veri/*-taramasi.json      merge=tetikte-robot
veri/ihale-kesik-*.json   merge=tetikte-robot
veri/URUN-KUNYELERI.json  merge=tetikte-robot

# ============================================================================
# 13.09.2026 CAKISMA DERSI — YAYIN KOSUSU DUSTU (Cem onayi ile eklendi)
#
# OLAY: gece iki uretim kosusu bitince zincir IKI yayin kosusu tetikledi. Yayin
# kosusu basinda depoyu cekiyor ama ~20-40 dk suruyor; itme aninda taban BAYAT
# kaliyor. 34729587713 tam boyle dustu: birlestirme
# veri/sinav/kaydir-secim/sgs-650-secim.json'da cakisti, dosyada <<<<<<< =======
# isaretleri kaldi, Ozet adimi onu JSON diye okumaya calisip patladi.
# ⭐ KAPI DOGRU CALISTI: bozuk icerik ANA TELE GITMEDI (kontrol edildi - cakisma
#   isareti 0, JSON gecerli). Kayip yalnizca o kosunun bosa gitmesiydi.
#
# NIYE BU DOSYALAR KURALA GIRIYOR: ikisi de HER yayin kosusunda AMBARDAN sifirdan
# uretiliyor (arac/havuz-kur.ps1 ve motor/kaydir-coz.ps1). Icinde el emegi YOK;
# cakismalari anlamsizdir, tipki yukaridaki rapor dosyalari gibi. Kuralin kendi
# olcutu bu: "her kosuda yeniden uretilen dosya".
#
# ⛔ veri/cevap-dagilimi.json BILEREK DISARIDA: o circir TABANLARINI tutar, yani
#   DURUM tasir. Korlemesine "yereli al" demek taban gecmisini bozabilir.
#
# TEST EDILDI (13.09, ayri bos depoda, driver tanimliyken) - dosyanin kendi
# uyarisi geregi ("merge=ours yazmak SESSIZCE HICBIR SEY YAPMAZ, 30.08'de
# calisiyor sanildi"): iki dal ayni dosyalari FARKLI degistirdi, birlestirildi.
#   veri/sinav/kaydir-secim/secim.json -> CAKISMADI, yerel korundu ✓
#   kaydir/sgs/ders.html               -> CAKISMADI, yerel korundu ✓
#   motor/betik.ps1 (desen DISI)       -> normal CAKISTI ✓
# Yani kural tam hedefine vuruyor ve tasmiyor.
# ============================================================================
veri/sinav/kaydir-secim/*.json   merge=tetikte-robot
kaydir/*/*.html                  merge=tetikte-robot
