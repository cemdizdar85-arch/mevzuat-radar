  "haric_tutulanlar": [
    {
      "ascii": "SIK",
      "gecis": 2,
      "sebep": "MESRU KELIME - DOKUNULMAYACAK. 'EN SIK HATA burada' = en cok yapilan hata. Ikisi de okundu, ikisi de dogru yazim. Harf-korur otomatik cevrim bunlari 'SIK' yapip metni BOZARDI."
    },
    {
      "ascii": "siki",
      "gecis": 16,
      "sebep": "KARISIK - 15 gecis 'sikki' (secenek) ama 1 gecis GERCEK 'siki' kelimesi: 'buro duzenini siki kurallara baglar'. Toptan degisim o satiri bozar. Elle ayiklanmali."
    },
    {
      "ascii": "sikke",
      "gecis": 4,
      "sebep": "BELIRSIZ - baglamda 'sikka' mi 'sikta' mi oldugu kesin degil ('Bu sikke farkli bir oran karistirilmistir'). Ayrica 'sikke' Turkcede gercek bir kelimedir (madeni para). Insan karari."
    },
    {
      "ascii": "sike",
      "gecis": 1,
      "sebep": "BELIRSIZ - 'ters islem bu sike ulastirir': 'sikka' mi 'sika' mi belirsiz. Tek gecis, elle duzeltilir."
    },
    {
      "ascii": "mudur",
      "gecis": 152,
      "onerilen_hedef": "müdür",
      "sebep": "Gecislerin neredeyse tamami \"Bu kayit dogru MUDUR?\" soru eki - mesru. 150 soru bozulurdu."
    },
    {
      "ascii": "asli",
      "gecis": 150,
      "onerilen_hedef": "aslı",
      "sebep": "Karisik: \"police ASLI\" (asil nusha) ile \"ASLI kamu gorevi\" (asli/esas) ayni yazimda."
    },
    {
      "ascii": "sure",
      "gecis": 143,
      "onerilen_hedef": "süre",
      "sebep": "Karisik: Turkce \"sure\" ile INGILIZCE \"make sure\" (Ingilizce sorular) ayni yazimda."
    },
    {
      "ascii": "tur",
      "gecis": 129,
      "onerilen_hedef": "tür",
      "sebep": "Karisik: \"bu TUR rakamlar\" (tur) ile \"ikinci TUR etkisi\" / \"TUR organizasyonu\" (tur) ayni yazimda."
    },
    {
      "ascii": "kismi",
      "gecis": 53,
      "onerilen_hedef": "kısmi",
      "sebep": "Otomatik hedef YANLIS. Gecisler \"sabit KISMI\", \"asan KISMI\" yani kismi degil KISMI. Hafizadaki kismi uyarisi birebir dogrulandi."
    },
    {
      "ascii": "kari",
      "gecis": 45,
      "onerilen_hedef": "karı",
      "sebep": "Hepsi kar/kazanc anlaminda ama yazim karari Cem in: kari mi kari mi (sapkali). Anlam belirsiz degil, IMLA karari bekliyor."
    },
    {
      "ascii": "turu",
      "gecis": 43,
      "onerilen_hedef": "türü",
      "sebep": "Ayni aile: \"gorus TURU\" (turu) ile \"Ilk TURU dusme\" (tur) ayni yazimda."
    }
  ],
  "kural": "Belirsiz kelime sozluge GIRMEZ. Ayni ilke 'kismi' vakasinda da uygulanmisti (kismi mi kismi mi baglamsiz cozulemez)."
