    "muhasebe bilgi sistemi",
    "hisse senedi satisi",
    "depozito iadesi kaydi",
    "donem kari zarari hesabi",
    "yedek akce ayirma",
    "satilan ticari mal maliyeti",
    "donem ayirici hesaplar",
    "ifac bunyesindeki kuruluslar",
    "duzenleyici hesaplar",
    "muhasebe bilgi sistemi sureci",
    "avans mahsup kaydi",
    "ozkaynak degisimi",
    "tutarlilik kavrami",
    "gelir-gider hesaplari isleyisi",
    "kapsamli gelir",
    "ozkaynak hesaplari"
