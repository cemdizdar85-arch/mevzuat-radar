[
    "sebepsiz zenginlesme",
    "borc iliskisi kaynaklari",
    "esasli yanilma",
    "is tazminatlari zamanasimi",
    "kollektif sirket kurulusu",
    "sermaye sirketleri",
    "sozlesmede kesin hukumsuzluk",
    "tacir olmanin sonuclari",
    "telafi calismasi",
    "acente borclari",
    "zamanasimi",
    "dava sarti arabuluculuk",
    "genel islem kosullari",
    "hukuksal islem turleri",
    "is kazasi tanimi",
    "kisa vadeli sigorta kollari",
    "olum sigortasi haklari",
    "tacir sifati ve temsil",
    "ticaret sicili etkisi",
    "ticari is tanimi",
    "yillik ucretli izin sureleri",
    "ticari defter aleyhine delil"
]