[
    "mesleki muhakeme",
    "denetim teknikleri",
    "denetim sozlesmesi unsurlari",
    "bagimsiz denetim resmi sicili",
    "bdy yetkilendirme esaslari",
    "denetci mesleki egitim suresi",
    "denetim faaliyeti kisitlamalari",
    "denetim kaniti guvenilirligi",
    "denetim kistasi belirleme",
    "denetim raporu tanimi",
    "etik ilkeler",
    "genel kabul gormus denetim standartlari",
    "hileye iliskin sorumluluklar",
    "kalite yonetim sistemi sorumlulugu",
    "kayik denetimi yetkisi",
    "reklam ve haksiz rekabet yasagi",
    "uygulamali mesleki egitim suresi",
    "yonetimin on kabul sorumluluklari",
    "ic kontrol unsurlari",
    "bagimsiz denetci tanimi",
    "calisma kagitlari birlestirme",
    "denetci temel etik ilkeleri",
    "denetim kalitesi gozden gecirme",
    "denetim raporu gorus turleri",
    "denetim sureci asamalari",
    "denetim ucreti belirlenmesi",
    "denetimde onemlilik kavrami",
    "esasta ve sekilde bagimsizlik",
    "hile risk faktorleri",
    "ic kontrol amaclari"
]