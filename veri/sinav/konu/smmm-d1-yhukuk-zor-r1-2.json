[
    "sigortalilik baslangic tarihleri",
    "sozlesmede kesin hukumsuzluk",
    "tacir olmanin hukumleri",
    "tacir yardimcilari",
    "ticaret sicili etkisi",
    "ticaret siciline tescil suresi",
    "ticari is karinesi",
    "vergi davasi yurutmeyi durdurma",
    "yasal sureler",
    "yetkili vergi mahkemesi",
    "yurutmenin durdurulmasi istisnalari"
]