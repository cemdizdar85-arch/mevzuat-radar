[
    "kidem tazminati kosullari",
    "fiil ehliyeti",
    "ticari isletme unsurlari",
    "hizmet akdi borclari",
    "ticari isletme tanimi",
    "kambiyo senetleri ozellikleri",
    "yazili is sozlesmeleri",
    "tacir olmanin sonuclari",
    "kollektif sirket kurulusu",
    "hizmet akdi turleri",
    "ihtiyati haciz",
    "sebepsiz zenginlesme unsurlari",
    "kidem tazminati",
    "tuzel kisi turleri",
    "limited sirket temsili",
    "idari yargi ve anayasa mahkemesi"
]