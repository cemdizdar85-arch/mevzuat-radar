[
    "kidem tazminati kosullari",
    "fiil ehliyeti",
    "ticari isletme unsurlari",
    "hizmet akdi borclari",
    "ticari isletme tanimi",
    "kambiyo senetleri ozellikleri",
    "yazili is sozlesmeleri",
    "tacir olmanin sonuclari",
    "kollektif sirket kurulusu",
    "hizmet akdi turleri",
    "ihtiyati haciz",
    "sebepsiz zenginlesme unsurlari",
    "kidem tazminati",
    "tuzel kisi turleri",
    "limited sirket temsili",
    "idari yargi ve anayasa mahkemesi",
    "ikametgah tanimi ve turleri",
    "idari yargi sureleri",
    "is kanunu kapsam disi isler",
    "cekin zorunlu unsurlari",
    "yargi yeri uyusmazligi",
    "hakkin kotuye kullanilmasi",
    "is sozlesmesi fesih halleri",
    "ticaret sirketi turleri",
    "bolge idare mahkemesi gorevleri",
    "esasli yanilma",
    "sozlesmelerde hukumsuzluk",
    "idari yargida merci tayini",
    "ticari defter tutma",
    "ticari senetler ortak ozellikleri",
    "komandit sirket ticaret unvani",
    "vergi dava acma suresi",
    "takas sartlari hukumleri",
    "sozlesmede kesin hukumsuzluk",
    "posta ucreti eksikligi",
    "asil isveren alt isveren"
]