[
    "ticari orf ve adet",
    "tacir sifati kurallari",
    "genel kurul iptal davasi suresi",
    "unvan kullanma cezasi (6 ay-1 yil)",
    "tacir sifatinin sonuclari",
    "pay senedi getirisi",
    "cek ibraz sureleri (10 gun-1 ay)",
    "ticaret unvani ve isletme adi",
    "ayni sermaye taahhudunun yerine getirilmesi",
    "anonim sirket genel kurulu",
    "bonoda kosullu ciro (yazilmamis sayilma)",
    "ayni sermaye kurallari"
