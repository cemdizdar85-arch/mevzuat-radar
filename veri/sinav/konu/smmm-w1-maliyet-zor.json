[
    "tam maliyet yontemi",
    "gug yukleme katsayisi",
    "tutar saglamasi",
    "ikinci dagitim matematiksel yontem",
    "kademeli dagitim yontemi",
    "esdeger mamul birimi",
    "tamamlanan mamul maliyeti",
    "esdeger uretim miktari",
    "miktar saglamasi",
    "degisken maliyet yontemi",
    "ikinci dagitim kademeli yontem",
    "donem ici yevmiye kayitlari",
    "donem personel gideri",
    "lifo stok karti",
    "net satis degeri yontemi",
    "uretim kayiplari"
]