[
    "fazla calisma ve mazeret izni",
    "idareye basvuruda cevap suresi",
    "idari dava acma suresi",
    "idari islem kaldirilmasi basvurusu",
    "idari yargi kararlarinin uygulanmasi",
    "idari yargi ve vergi yargilamasi",
    "is kanunu isveren kapsami",
    "is kanunu kapsam disi isler",
    "is sozlesmesinin feshi",
    "isverenin isciye borclari",
    "kira sozlesmesi sureleri ve feshi",
    "kisa vadeli sigorta kollari",
    "kollektif sirket sorumluluk",
    "kollektif sirket tur degistirme",
    "malulluk ayligi sartlari",
    "olum sigortasi haklari",
    "sebepsiz zenginlesme zamanasimi",
    "sgk bildirim sureleri",
    "sgk isyeri bildirgesi",
    "sozlesmede kesin hukumsuzluk",
    "sozlesmenin kesin hukumsuzlugu",
    "tacir olmanin hukumleri",
    "tacir sifati ve temsil",
    "tacirin ticari is karinesi",
    "ticaret sicili etkisi",
    "ticaret sicili tescil suresi",
    "ticaret sirketi turleri",
    "ticari arabuluculuk suresi",
    "ticari is karinesi",
    "ticari isletme unsurlari"
]