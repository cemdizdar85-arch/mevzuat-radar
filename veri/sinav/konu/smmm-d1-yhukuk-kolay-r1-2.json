[
    "ticaret sicili tescil suresi",
    "toplu isci cikarma bildirimi",
    "yeni is arama izni",
    "acente borclari",
    "gercek kisi tacir",
    "hukuk kaynaklari hiyerarsisi",
    "kambiyo senetleri ozellikleri",
    "tacir tanimi",
    "temsil yetkisinin sona ermesi",
    "yenilik doguran hak",
    "anonim sirket kurulus sermaye yonetim",
    "cekin zorunlu unsurlari",
    "dava sarti arabuluculuk",
    "eksik borclar",
    "fazla calisma ve mazeret izni",
    "genel islem kosullari",
    "haksiz rekabet",
    "hizmet akdi turleri",
    "idareye basvuruda cevap suresi",
    "idari islem kaldirilmasi basvurusu",
    "idari yargi kararlarinin uygulanmasi",
    "idari yargi ve vergi yargilamasi",
    "is kanunu isveren kapsami",
    "is kazasi tanimi",
    "iscinin borclari",
    "isverenin isciye borclari",
    "kidem tazminati",
    "kira sozlesmesi tanimi",
    "kisa vadeli sigorta kollari",
    "kollektif sirket tescil sorumlulugu"
]