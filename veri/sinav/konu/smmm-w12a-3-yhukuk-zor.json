[
    "kambiyo senetleri ozellikleri",
    "idari yargi ilk inceleme",
    "sozlesme icerigi sinirlama",
    "tasima sozlesmesi zamanasimi",
    "kollektif sirket kurulusu",
    "ticari dava gorevli mahkeme",
    "ttk ticari isler hukumleri",
    "ticari orf ve adet",
    "ticaret sirketi turleri",
    "sozlesme serbestisi ilkesi",
    "denetim engelleme cezasi",
    "iptal davasi tanimi",
    "vergi davasi yurutmeyi durdurma",
    "is sozlesmesi fesih halleri"
]