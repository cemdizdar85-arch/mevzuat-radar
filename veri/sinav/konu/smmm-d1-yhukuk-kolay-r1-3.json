[
    "komandit sirket ticaret unvani",
    "sebepsiz zenginlesme zamanasimi",
    "sozlesmede hukumsuzluk",
    "tacir sifati ve temsil",
    "tacirin ticari is karinesi",
    "ticaret sicili etkisi",
    "ticari is karinesi",
    "vergi davasi yurutmeyi durdurma",
    "defter tutma zorunlulugu",
    "fiil ehliyeti kosullari",
    "hak kavrami ve turleri",
    "ticari defter aleyhine delil"
]