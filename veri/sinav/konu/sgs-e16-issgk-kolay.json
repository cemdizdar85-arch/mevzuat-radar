[
    "sendika kanunu tanimlari",
    "toplu is sozlesmesi",
    "is kanunu calisma sureleri",
    "gecici is goremezlik sigorta kollari",
    "sigortali sayilmayanlar",
    "is kazasi surekli is goremezlik",
    "fazla calisma",
    "belirli sureli is sozlesmesi",
    "fiili hizmet suresi zammi",
    "fazla calisma hukumleri"
]