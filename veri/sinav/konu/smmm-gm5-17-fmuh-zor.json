    "stok karsiligi iptali",
    "borc alacak mahsubu",
    "vergi borcu vadesinde odenmeme",
    "kur farki faiz tahakkuku",
    "uretim miktari yontemi amortisman",
    "satistan iade siparis avansi",
    "tahsilat ve vergi mahsubu",
    "yatirim amacli gayrimenkul siniflandirma",
    "ticari mal satisi nakliye"
