[
    "muhasebe usulsuzluk sucu",
    "sermaye piyasasi araci tanimlari",
    "spk tanimlar",
    "spk tedbir yetkileri ve tedrici tasfiye",
    "turkiye sermaye piyasalari birligi gorevleri",
    "yatirim kurulusu yan hizmetler",
    "yetki belgesi (faaliyet izni) iptali",
    "birinci ikinci el piyasa",
    "birincil piyasa tanimi",
    "girisim sermayesi yatirim ortakligi",
    "ipotek varlik teminatli menkul kiymet"
]