[
    "etik ilkelere tehditler",
    "meslek mensubu genel sartlari",
    "meslekten cikarma cezasi",
    "disiplin cezalari",
    "oda organlari",
    "etik ilkeler tehdit onlemleri",
    "meslek onuruyla bagdasmayan haller",
    "calisanlar listesinden silinme",
    "etik ilkeler kisisel cikar tehdidi",
    "haksiz rekabet reklam yasagi",
    "meslek mensubu olma sartlari",
    "ticari faaliyette bulunma yasagi",
    "zorunlu sozlesme konulari",
    "birlik organlari",
    "tarafsizlik ilkesi",
    "etik ilke tehditleri"
]